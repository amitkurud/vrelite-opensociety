{
  "expo": {
    "name": "OpenSociety",
    "slug": "opensociety",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#234F40",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OpenSociety to use the camera to scan visitor pre-approval QR codes at the gate.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F2",
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#234F40"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34286bb3-aa5a-4e24-a060-973c2eb40ecd"
      }
    },
    "owner": "amitkurud"
  }
}
