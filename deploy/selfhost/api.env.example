# Copy to api.env and chmod 600. API runtime secrets.
# DATABASE_URL is set by compose.yaml to the bundled PostgreSQL service.

# production requires sk_live_; use APP_ENV=staging with sk_test_ keys.
APP_ENV=production
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Exact HTTPS origin(s) of the web dashboard, comma-separated.
WEB_ORIGINS=https://society.example.com

# Object storage for photos/documents (required in production). Cloudflare R2:
R2_ACCOUNT_ID=REPLACE_ME
R2_BUCKET_NAME=opensociety-uploads
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
# Or any S3-compatible store reachable over HTTPS:
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true

# Enable only after bill configuration has been reviewed.
BILLING_ENABLED=false
# Enable after FCM/APNs setup and a physical-device test.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
BILL_REMINDER_DAYS=-7,0,3
SOCIETY_TIME_ZONE=Asia/Kolkata

# Max PostgreSQL connections held by the API (default 10).
# DATABASE_POOL_MAX=10
