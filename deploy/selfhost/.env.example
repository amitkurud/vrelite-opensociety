# Copy to .env and chmod 600. Compose-level settings (no app secrets beyond the DB password).

# Use letters and digits only (it is embedded in a URL): openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_USER=opensociety
POSTGRES_DB=opensociety

# Public HTTPS hostnames. The web image bakes in https://API_DOMAIN at build time.
WEB_DOMAIN=society.example.com
API_DOMAIN=api.society.example.com

# Clerk publishable key baked into the web build. pk_live_ for production;
# with a pk_test_ key set WEB_DEPLOY_ENV=staging (and APP_ENV=staging in api.env).
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
WEB_DEPLOY_ENV=production

# Where the app ports listen on the host. 127.0.0.1 when Caddy runs on this host
# (bundled or system); the server's LAN IP if a reverse proxy elsewhere forwards here.
BIND_ADDRESS=127.0.0.1
API_PORT=8787
WEB_PORT=3000

BACKUP_KEEP_DAYS=14

# Optional: run prebuilt images instead of building here, e.g.
# API_IMAGE=ghcr.io/amitkurud/vrelite-opensociety-api:latest
# MIGRATE_IMAGE=ghcr.io/amitkurud/vrelite-opensociety-migrate:latest
